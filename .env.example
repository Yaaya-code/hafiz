# ═══════════════════════════════════════════════════════════════════
# Hafiz — environment template
# Copy to `.env.local` for development or set in your host (Vercel, etc.)
# App runs fully offline/local without any of these variables.
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL (Supabase recommended) ─────────────────────────────
# Supabase Dashboard → Project Settings → Database
#
# 1) Connection string (Transaction / pooler) → DATABASE_URL
# 2) Direct connection (Session, port 5432)  → DIRECT_URL
#    Required for `prisma db push` / migrations on Supabase.
#
# Example (replace placeholders):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Local Postgres / Neon (DIRECT_URL may equal DATABASE_URL):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ── Auth (required for real signup/login JWT cookies) ─────────────
# Generate a strong secret (do NOT commit the real value):
#   openssl rand -base64 32
#
# Production MUST set AUTH_SECRET:
#   - minimum 32 characters
#   - not a template / "change-me" / "replace-with-..." value
#   - never hardcode in source
# Development may fall back to a known-dev-only secret if unset.
AUTH_SECRET="replace-with-a-long-random-secret-min-32-chars"

# Optional: require login OR guest cookie for app routes (default: open local-first)
# REQUIRE_AUTH=true

# Session lifetime in days (default 30)
# AUTH_SESSION_DAYS=30

# Show auth/DB warnings on GET /api/v1/auth/me even in production
# AUTH_DEBUG=1

# ── Optional: Supabase project metadata (future OAuth / client SDK) ─
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── Optional: free local LLM for Surah helpers ────────────────────
# OLLAMA_BASE_URL="http://127.0.0.1:11434"

# ── Node ──────────────────────────────────────────────────────────
# NODE_ENV=production
